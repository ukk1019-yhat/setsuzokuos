{
  "name": "setsuzoku-os",
  "version": "1.0.0",
  "private": true,
  "description": "SETSUZOKU OS - From First Inquiry to Final Payment",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @setsuzoku/api --filter @setsuzoku/web --parallel dev",
    "dev:api": "pnpm --filter @setsuzoku/api run dev",
    "dev:web": "pnpm --filter @setsuzoku/web run dev"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
